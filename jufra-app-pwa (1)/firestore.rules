rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace these two with the real emails of the Firebase Authentication users.
    // The till account (cashier devices) can only write. The owner account can read everything and write.
    function isTill()  { return request.auth != null && request.auth.token.email == 'TILL_EMAIL_HERE'; }
    function isOwner() { return request.auth != null && request.auth.token.email == 'OWNER_EMAIL_HERE'; }

    match /shops/jufra/{collection}/{docId} {
      allow read: if isOwner();                    // the owner page reads everything
      allow create, update: if isTill() || isOwner();  // tills push records (the owner's phone can also run the till)
      allow delete: if false;                      // history can never be erased from the app
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
